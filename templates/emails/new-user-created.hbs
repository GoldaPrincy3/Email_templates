<table width="100%">

  <tr>
    <td style="gap:5px;">

      <!-- TITLE -->
      <!-- TITLE -->
<div style="
  color:#0A0B18;
  font-family:Arial;
  font-size:25px;
  font-weight:700;
  letter-spacing:-0.5px;
  margin-bottom:16px;
">
  {{title}}
</div>

<!-- BADGES -->
<div style="margin-bottom:24px;">
  {{> info-badge label="INFORMATION"}}
  {{> alert-badge label="General Alert"}}
</div>

      <!-- GREETING -->
      <div style="
        color:#0A0B18;
        font-family:Arial;
        font-size:16px;
        line-height:28px;
        margin-bottom:24px;
      ">
        <div>Hi {{userName}},</div>

        <div style="margin-top:8px;">
          {{message}}
        </div>
      </div>

      <!-- NEW SECTION -->
    

    </td>
  </tr>

  <!-- USER DETAILS -->
  <tr>
    <td style="gap:10px;">
      <div style="color: #0A0B18;
font-family: Arial;
font-size: 15px;
font-style: normal;
font-weight: 700;
line-height: 22px; 
text-transform: uppercase;">USER DETAILS:</div>

      {{> table rows=userDetails}}
    </td>
  </tr>

  <!-- CREATED DETAILS -->
  <tr>
       <td style="gap:10px;">
      <div style="color: #0A0B18;
font-family: Arial;
font-size: 15px;
font-style: normal;
font-weight: 700;
line-height: 22px; 
text-transform: uppercase;">CREATED DETAILS:</div>

      {{> table rows=createdDetails}}
    </td>
  </tr>

</table>