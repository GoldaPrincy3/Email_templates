<table width="100%" cellpadding="0" cellspacing="0" border="0">

  <!-- TITLE + BADGES -->
  <tr>
    <td>

      <div style="
        color:#0A0B18;
        font-family:Arial;
        font-size:25px;
        font-weight:700;
        letter-spacing:-0.5px;
        margin-bottom:16px;
      ">
        {{title}}
      </div>

      <div style="margin-bottom:24px;">
        {{> info-badge
            label="Critical"
            critical=true
        }}

        {{> alert-badge label="General Alert"}}
      </div>

    </td>
  </tr>

  <!-- SPACE -->
  <tr>
    <td height="24"></td>
  </tr>

  <!-- GREETING -->
  <tr>
    <td>

      <div style="
        color:#0A0B18;
        font-family:Arial;
        font-size:16px;
        line-height:28px;
      ">
        <div>Hi {{userName}},</div>

        <div style="margin-top:8px;">
          {{message}}
        </div>
      </div>

    </td>
  </tr>

  <!-- SPACE -->
  <tr>
    <td height="32"></td>
  </tr>

  <!-- USER DETAILS -->
  <tr>
    <td>

      <div style="
        color:#0A0B18;
        font-family:Arial;
        font-size:15px;
        font-weight:700;
        line-height:22px;
        text-transform:uppercase;
        margin-bottom:12px;
      ">
        USER DETAILS:
      </div>

      {{> table rows=userDetails}}

    </td>
  </tr>

  <!-- SPACE -->
  <tr>
    <td height="32"></td>
  </tr>

  <!-- CREATED DETAILS -->
  <tr>
    <td>

      <div style="
        color:#0A0B18;
        font-family:Arial;
        font-size:15px;
        font-weight:700;
        line-height:22px;
        text-transform:uppercase;
        margin-bottom:12px;
      ">
        CREATED DETAILS:
      </div>

      {{> table rows=createdDetails}}

    </td>
  </tr>

</table>