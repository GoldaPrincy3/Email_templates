

<span style="
  display:inline-block;
  padding:1px 10px;
  border-radius:5px;

  font-family:Arial;
  font-size:12px;
  font-style:normal;
  font-weight:700;
  line-height:22px;

  text-transform:uppercase;

  {{#if information}}
    background:#EAF2FF;
    color:#216CFF;
    border:1px solid #216CFF;
  {{/if}}

  {{#if warning}}
    background:#FFF7E8;
    color:#F5A623;
    border:1px solid #F5A623;
  {{/if}}

  {{#if critical}}
    background:#FFEAEA;
    color:#E53935;
    border:1px solid #E53935;
  {{/if}}
">
  {{label}}
</span>