<table
  width="100%"
  cellspacing="0"
  cellpadding="0"
  border="0"
  style="
    border-collapse:collapse;
    width:100%;
    margin-top:10px;
  "
>

  {{#each rows}}
    <tr>

      <td
        width="161"
        valign="top"
        style="
          padding:12px 15px;
          border:1px solid #DCDCDC;
          background:#EFEFED;
          font-family:Arial,sans-serif;
          font-size:14px;
          font-weight:700;
          color:#0A0B18;
        "
      >
        {{label}}
      </td>

      <td
        valign="top"
        style="
          padding:12px 15px;
          border:1px solid #DCDCDC;
          font-family:Arial,sans-serif;
          font-size:14px;
          color:#0A0B18;
        "
      >
        {{value}}
      </td>

    </tr>
  {{/each}}

</table>